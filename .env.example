# ──────────────────────────────────────────────
# Node Website Backend — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Server
PORT=3001

# CORS — set this to your frontend domain in production
# e.g., https://node.barshandey.dev
CORS_ORIGIN=*

# SMTP — used by nodemailer to send contact form emails
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Where contact form emails are delivered
CONTACT_EMAIL=itzbarshandey@gmail.com
