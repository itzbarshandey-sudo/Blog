{
  "name": "node-cybersecurity-journal",
  "version": "1.0.0",
  "description": "Barshan Dey's cybersecurity journal — static frontend with a backend contact form API",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "dev": "npx nodemon server/server.js",
    "serve": "npx http-server . -p 8000 -c-1",
    "preview": "npx concurrently \"npm run serve\" \"npm run dev\"",
    "compress": "node scripts/compress-images.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Barshan Dey",
  "license": "MIT"
}
